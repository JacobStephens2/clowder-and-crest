# Copy to ../.env (chmod 600, gitignored) and fill in the secrets.
CLOWDER_SYNC_DB=postgresql://clowder_sync_app:CHANGE_ME@127.0.0.1:5432/clowder_sync
CLOWDER_SYNC_PORT=3486
CLOWDER_BASE_URL=https://clowderandcrest.com
# Set to 1 to require a verified email before cloud sync turns on (default 0:
# sync works immediately on signup; verification gates only password reset).
CLOWDER_REQUIRE_VERIFIED=0
# Comma-separated; defaults already cover both web domains + Capacitor + Vite.
# CLOWDER_CORS_ORIGINS=https://clowderandcrest.com,https://clowder.stephens.page,...
# Email via Resend SMTP (shared stephens.page key). stephens.page is the
# verified sending domain — do not send from @clowderandcrest.com until it's
# verified in Resend or mail will bounce.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=CHANGE_ME
SMTP_FROM_EMAIL=noreply@stephens.page
CLOWDER_MAIL_FROM_NAME=Clowder & Crest
