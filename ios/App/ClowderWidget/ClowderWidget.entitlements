<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Must match the app's group so the widget can read the snapshot the
	     game writes via ClowderBridgePlugin. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.page.stephens.clowder.crest</string>
	</array>
</dict>
</plist>
