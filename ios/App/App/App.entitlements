<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared container so the game (this app) and the ClowderWidget
	     extension can read/write the same widget snapshot. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.page.stephens.clowder.crest</string>
	</array>
</dict>
</plist>
